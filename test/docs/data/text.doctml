<document>
    <section size="A4" margin="5mm"/>

    <!--
    font: Spaces preserved.
    -->

    <p> space_after <font bold="1">space_before_and_after</font> <font underline="single">space_before</font>.</p>
    <p> space_after <font>space_before_and_after</font> <font>space_before</font>.</p>
    <p> space_after <b>space_before_and_after</b> <u>space_before</u>.</p>
    <p>
        space_after
        <font bold="1">space_before_and_after</font>
        <font underline="single">space_before</font>.
    </p>
    <p>
        space_after
        <font>space_before_and_after</font>
        <font>space_before</font>.
    </p>
    <p>
        space_after
        <b>space_before_and_after</b>
        <u>space_before</u>.
    </p>

    <!--
    END
    -->

</document>
