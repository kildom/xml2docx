<%! tools = eval(utils.include("include/tools.js"))(utils); %>
<document>

    <!--
    img: Check if img works.
    -->

    <img src="include/images/mountains.png" width="5cm"/>

    <!--
    img.src: Check different image formats (except SVG).
    -->

    PNG:
        <img src="include/images/mountains.png" width="5cm"/>
        <img src="include/images/tree.png" height="3cm"/>
        <br/>
    JPEG:
        <img src="include/images/mountains.jpg" width="5cm"/>
        <img src="include/images/tree.jpg" height="3cm"/>
        <br/>
    GIF:
        <img src="include/images/mountains.gif" width="5cm"/>
        <br/>
    BMP:
        <img src="include/images/mountains.bmp" width="5cm"/>
        <br/>

    <!--
    img.src: Check SVG image format.
    -->

    SVG, solid, no fallback:
        <img src="include/images/mountains.svg" width="5cm"/>
        <br/>

    SVG, transparent, no fallback:
        <img src="include/images/mountains-transparent.svg" width="5cm"/>
        <br/>

    <!--
    img.src: Check PNG transparency.
    -->

    <p>
        <img src="include/images/mountains-transparent.png" width="5cm"/>
        <img src="include/images/tree-transparent.png" height="3cm"/>
    </p>

    <p background="red">
        <img src="include/images/mountains-transparent.png" width="5cm"/>
        <img src="include/images/tree-transparent.png" height="3cm"/>
    </p>

    <!--
    END
    -->

</document>
