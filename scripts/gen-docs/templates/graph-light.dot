digraph "DocTML tags hierarchy" {

    graph [bgcolor="transparent" target="_parent"];
    node [fontname="Arial" style=filled fillcolor="#e6f3fc" color="#2e5d98" fontcolor="#01275b" fontbold=true target="_parent"];
    fontname="Arial";
    rankdir="LR";

    <%! for (let node of nodes) { %>
        "<% node.id %>" [label=<<B><% node.name %></B>> tooltip="<% node.brief %>" URL="<% node.link %>"]
    <%! } %>

    <%! for (let group of groups) { %>
        "<% group.id %>" [shape=rect margin="0.007" tooltip="Group: <% group.name %>" label=<
          <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR>
              <TD COLSPAN="1" BGCOLOR="#3375b5" ALIGN="CENTER" TOOLTIP="Group: <% group.name %>"><FONT COLOR="white">&nbsp;&nbsp;<B><% group.name %></B>&nbsp;&nbsp;</FONT></TD>
            </TR>
            <%! for (let i = 0; i < group.items.length; i++) {
                let item = group.items[i]; %>
                <TR><TD HREF="<% item.link %>" TOOLTIP="<% item.brief %>" BGCOLOR="#<% i & 1 ? "e4f1fc" : "FFFFFF" %>">&nbsp;&nbsp;<% item.name %>&nbsp;&nbsp;</TD></TR>
            <%! } %>
          </TABLE>
        >];
    <%! } %>

    <%! for (let edge of edges) { %>
        "<% edge.from %>" -> "<% edge.to %>"
        <%! if (edge.implicit) { %>
            [color="#578ed1:#95beef:#578ed1"]
        <%! } else { %>
            [color="#2e5d98"]
        <%! } %>
    <%! } %>
}
