digraph "DocTML tags hierarchy" {

    node [fontname="Arial" style=filled fillcolor="#0f2231" color="#2d5177" fontcolor="#d9dce0" fontbold=true];
    edge [color="#a2a2a2"]
    fontname="Arial";
    rankdir="LR";

    <%! for (let node of nodes) { %>
        "<% node.id %>" [label=<<B><% node.name %></B>> tooltip="<% node.brief %>" URL="<% node.link %>"]
    <%! } %>

    <%! for (let group of groups) { %>
        "<% group.id %>" [shape=rect margin="0.007" label=<
          <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR>
              <TD COLSPAN="1" BGCOLOR="#193659" ALIGN="CENTER"><FONT COLOR="white">&nbsp;&nbsp;<B><% group.name %></B>&nbsp;&nbsp;</FONT></TD>
            </TR>
            <%! for (let i = 0; i < group.items.length; i++) {
                let item = group.items[i]; %>
                <TR><TD HREF="<% item.link %>" TOOLTIP="<% item.brief %>" BGCOLOR="#<% i & 1 ? "0f2231" : "0c1a25" %>">&nbsp;&nbsp;<% item.name %>&nbsp;&nbsp;</TD></TR>
            <%! } %>
          </TABLE>
        >];
    <%! } %>

    <%! for (let edge of edges) { %>
        "<% edge.from %>" -> "<% edge.to %>"
        <%! if (edge.implicit) { %>
            [color="#364454:#212931:#364454"]
        <%! } else { %>
            [color="#415469"]
        <%! } %>
    <%! } %>
}
